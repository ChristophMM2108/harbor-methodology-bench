__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Generated benchmark tasks and large source datasets
/generated/*
/source-tasks/terminal-bench/

# Raw Harbor execution output: one directory per job, agent trajectories and
# session state included. Reproduced by re-running a job; reports in results/
# are the durable artifact.
/jobs/*

# Keep the directory layout available in a clean clone. A negation only works
# when the parent directory itself is not excluded, hence the `/*` patterns above.
!/generated/.gitkeep
!/jobs/.gitkeep

# Experiment outputs: reports, summaries, generated catalogues and analysis
# notebooks all belong to a run, not to the framework. Keep them on the branch
# that produced them, or archive them outside the repository.
/results/*
!/results/.gitkeep

# Local credentials/config
config/local.env
*.local

# Editors/OS
.vscode/
.idea/
.DS_Store

# Whole-repo dumps generated by Repomix for feeding the codebase to a model.
# Derived from tracked files, so committing one would just duplicate the repo.
repomix-summary.md
repomix-output.*
