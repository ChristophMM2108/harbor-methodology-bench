# Host-forwarded agent credentials. Git-ignored; keep it mode 600.
#
# Claude Code: print a single-line token with
#   claude setup-token
# and paste it below.
CLAUDE_FORCE_OAUTH=1
CLAUDE_CODE_OAUTH_TOKEN="<paste-your-single-line-token-here>"

# Codex CLI: forward the host's auth.json instead of a token.
CODEX_FORCE_AUTH_JSON=1
