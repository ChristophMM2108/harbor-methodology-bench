# Optional convenience template. Nothing in this repository reads it; the CLI and
# the scripts resolve every path relative to the repository root themselves.
#
# Copy to config/benchmark.env and `source` it if you want these paths in your
# shell. BENCHMARK_ROOT is derived, so the file is host-independent: it works from
# any checkout location and for any user.
BENCHMARK_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)"
SOURCE_TASKS_ROOT="${BENCHMARK_ROOT}/source-tasks/terminal-bench"
GENERATED_DIR="${BENCHMARK_ROOT}/generated"
RESULTS_DIR="${BENCHMARK_ROOT}/results"
